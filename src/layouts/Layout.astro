---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Claudia Sierra | Clases Particulares y Pedagogía Personalizada",
  description = "Acompañamiento pedagógico personalizado, mentoría académica y refuerzo escolar enfocado en la confianza, el rigor intelectual y el amor por aprender."
} = Astro.props;
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />

    <!-- Google Fonts & Icons -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Plus+Jakarta+Sans:wght@600;700&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0..1,0&display=swap" rel="stylesheet" />

    <style is:global>
      @layer base {
        html, body {
          margin: 0;
          padding: 0;
        }
        body {
          overscroll-behavior: none;
        }
        main > :first-child {
          margin-top: 0 !important;
        }
        main > :last-child {
          margin-bottom: 0 !important;
        }
      }
      ::-webkit-scrollbar {
        display: none;
      }
      html {
        scroll-behavior: smooth;
        scroll-padding-top: 6rem;
      }
    </style>

    <!-- Tailwind Play CDN con configuración de tema y paleta personalizada -->
    <script is:inline src="https://cdn.tailwindcss.com"></script>
    <script is:inline>
      tailwind.config = {
        darkMode: "class",
        theme: {
          extend: {
            colors: {
              "inverse-on-surface": "#f2f0ed",
              "on-tertiary": "#ffffff",
              "surface-bright": "#fbf9f6",
              "on-surface": "#1b1c1a",
              "on-background": "#1b1c1a",
              "surface-container-high": "#eae8e5",
              "surface-dim": "#dbdad7",
              "on-tertiary-fixed": "#2f1400",
              "secondary": "#3f6650",
              "on-secondary-fixed": "#002112",
              "surface-variant": "#e4e2df",
              "on-error": "#ffffff",
              "tertiary-fixed-dim": "#ffb780",
              "primary": "#9e3c26",
              "background": "#fbf9f6",
              "inverse-primary": "#ffb4a3",
              "primary-fixed-dim": "#ffb4a3",
              "on-secondary-fixed-variant": "#284e3a",
              "surface": "#fbf9f6",
              "secondary-container": "#c1edd0",
              "on-primary-container": "#fffbff",
              "on-secondary-container": "#456d56",
              "tertiary-container": "#a96428",
              "on-primary": "#ffffff",
              "outline-variant": "#ddc0ba",
              "outline": "#8a726c",
              "inverse-surface": "#30312f",
              "error": "#ba1a1a",
              "primary-container": "#be543c",
              "on-primary-fixed": "#3d0600",
              "tertiary-fixed": "#ffdcc4",
              "surface-container-lowest": "#ffffff",
              "surface-container": "#efeeeb",
              "on-secondary": "#ffffff",
              "error-container": "#ffdad6",
              "on-primary-fixed-variant": "#822714",
              "on-tertiary-container": "#fffbff",
              "on-surface-variant": "#57423d",
              "primary-fixed": "#ffdad2",
              "on-tertiary-fixed-variant": "#6f3800",
              "secondary-fixed-dim": "#a6d0b5",
              "surface-container-highest": "#e4e2df",
              "surface-tint": "#a13e28",
              "surface-container-low": "#f5f3f0",
              "tertiary": "#8b4c11",
              "on-error-container": "#93000a",
              "secondary-fixed": "#c1edd0"
            },
            borderRadius: {
              DEFAULT: "1rem",
              lg: "2rem",
              xl: "3rem",
              full: "9999px"
            },
            spacing: {
              "gutter-desktop": "1.5rem",
              "space-md": "1rem",
              "space-xl": "2rem",
              "space-3xl": "4.5rem",
              "space-2xl": "3rem",
              "gutter-mobile": "1rem",
              "space-sm": "0.75rem",
              "space-4xl": "6rem",
              "max-width-text": "680px",
              "space-xs": "0.5rem",
              "space-2xs": "0.25rem",
              "max-width-content": "1180px",
              "space-lg": "1.5rem"
            },
            fontFamily: {
              "label-sm": ["Inter", "sans-serif"],
              "headline-lg": ["Plus Jakarta Sans", "sans-serif"],
              "headline-md": ["Plus Jakarta Sans", "sans-serif"],
              "display-hero": ["Plus Jakarta Sans", "sans-serif"],
              "headline-lg-mobile": ["Plus Jakarta Sans", "sans-serif"],
              "label-md": ["Inter", "sans-serif"],
              "display-hero-mobile": ["Plus Jakarta Sans", "sans-serif"],
              "headline-sm": ["Plus Jakarta Sans", "sans-serif"],
              "body-sm": ["Inter", "sans-serif"],
              "body-md": ["Inter", "sans-serif"],
              "body-lg": ["Inter", "sans-serif"]
            },
            fontSize: {
              "label-sm": ["12px", { lineHeight: "16px", letterSpacing: "0.04em", fontWeight: "600" }],
              "headline-lg": ["40px", { lineHeight: "48px", letterSpacing: "-0.025em", fontWeight: "600" }],
              "headline-md": ["28px", { lineHeight: "36px", letterSpacing: "-0.015em", fontWeight: "600" }],
              "display-hero": ["56px", { lineHeight: "64px", letterSpacing: "-0.03em", fontWeight: "700" }],
              "headline-lg-mobile": ["30px", { lineHeight: "38px", letterSpacing: "-0.02em", fontWeight: "600" }],
              "label-md": ["14px", { lineHeight: "18px", letterSpacing: "0.01em", fontWeight: "500" }],
              "display-hero-mobile": ["38px", { lineHeight: "44px", letterSpacing: "-0.025em", fontWeight: "700" }],
              "headline-sm": ["20px", { lineHeight: "28px", letterSpacing: "-0.01em", fontWeight: "600" }],
              "body-sm": ["14px", { lineHeight: "20px", letterSpacing: "0em", fontWeight: "400" }],
              "body-md": ["16px", { lineHeight: "24px", letterSpacing: "0em", fontWeight: "400" }],
              "body-lg": ["18px", { lineHeight: "28px", letterSpacing: "-0.005em", fontWeight: "400" }]
            }
          }
        }
      };
    </script>
  </head>
  <body class="bg-background font-body-md text-body-md text-on-surface antialiased min-h-screen flex flex-col selection:bg-primary-fixed selection:text-on-primary-fixed">
    <slot />
  </body>
</html>
