---
---

<section class="w-full py-space-3xl lg:py-space-4xl" id="servicios">
  <div class="max-w-max-width-content mx-auto px-gutter-mobile lg:px-gutter-desktop">
    <!-- Centered Header -->
    <div class="flex flex-col items-center text-center max-w-2xl mx-auto gap-space-xs mb-space-2xl">
      <span class="inline-flex items-center px-space-md py-1 rounded-full bg-secondary-fixed text-on-secondary-fixed font-label-sm text-label-sm">
        ¿Cómo te puedo ayudar?
      </span>
      <h2 class="font-headline-lg text-headline-lg-mobile lg:text-headline-lg text-on-surface tracking-tight">
        Programas y Clases a Medida
      </h2>
      <p class="font-body-md text-body-md text-on-surface-variant">
        Modalidad presencial u online en directo, adaptada a los objetivos curriculares de cada estudiante.
      </p>
    </div>

    <!-- Grid of 3 Cards with rounded-3xl and soft multi-layer shadows -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-space-lg">
      <!-- Tarjeta 1 -->
      <div class="flex flex-col justify-between p-space-xl rounded-[2.5rem] bg-surface-container-lowest shadow-[0_4px_24px_rgba(36,33,30,0.05)] hover:-translate-y-1.5 transition-all duration-300 group">
        <div class="flex flex-col gap-space-md">
          <div class="w-14 h-14 rounded-full bg-primary-fixed/40 flex items-center justify-center text-primary group-hover:bg-primary group-hover:text-on-primary transition-colors">
            <span class="material-symbols-outlined text-[28px]">calculate</span>
          </div>
          <div>
            <span class="font-label-sm text-label-sm text-primary font-semibold">Primaria y ESO</span>
            <h3 class="font-headline-md text-[22px] text-on-surface tracking-tight mt-1">Apoyo Escolar y Secundaria</h3>
          </div>
          <p class="font-body-md text-body-md text-on-surface-variant">
            Refuerzo integral en matemáticas, ciencias y comprensión lectora; técnicas de estudio autónomo y resolución de dudas diarias sin bloqueo.
          </p>
          <ul class="flex flex-col gap-2 font-body-sm text-body-sm text-on-surface-variant/90 pt-2">
            <li class="flex items-center gap-2">
              <span class="material-symbols-outlined text-secondary text-[18px]">check_circle</span> Hábitos de estudio diarios
            </li>
            <li class="flex items-center gap-2">
              <span class="material-symbols-outlined text-secondary text-[18px]">check_circle</span> Matemáticas sin frustración
            </li>
            <li class="flex items-center gap-2">
              <span class="material-symbols-outlined text-secondary text-[18px]">check_circle</span> Informes mensuales a padres
            </li>
          </ul>
        </div>
        <div class="pt-space-xl">
          <a
            class="inline-flex items-center justify-between w-full px-space-lg py-3 rounded-full bg-surface-container-low text-on-surface font-label-md text-label-md hover:bg-primary hover:text-on-primary transition-all"
            href="https://wa.me/?text=Hola%20Clara,%20quisiera%20información%20sobre%20Apoyo%20Escolar"
            rel="noopener noreferrer"
            target="_blank"
          >
            <span>Más detalles &amp; temario</span>
            <span class="material-symbols-outlined text-[18px]">arrow_forward</span>
          </a>
        </div>
      </div>

      <!-- Tarjeta 2 -->
      <div class="flex flex-col justify-between p-space-xl rounded-[2.5rem] bg-surface-container-lowest shadow-[0_4px_24px_rgba(36,33,30,0.05)] hover:-translate-y-1.5 transition-all duration-300 group">
        <div class="flex flex-col gap-space-md">
          <div class="w-14 h-14 rounded-full bg-secondary-fixed/50 flex items-center justify-center text-secondary group-hover:bg-secondary group-hover:text-on-secondary transition-colors">
            <span class="material-symbols-outlined text-[28px]">assignment_turned_in</span>
          </div>
          <div>
            <span class="font-label-sm text-label-sm text-secondary font-semibold">Bachillerato &amp; EVAU</span>
            <h3 class="font-headline-md text-[22px] text-on-surface tracking-tight mt-1">Preparación para Exámenes</h3>
          </div>
          <p class="font-body-md text-body-md text-on-surface-variant">
            Selectividad, pruebas de acceso y recuperaciones con simulacros prácticos cronometrados, rúbricas reales y control pedagógico de la ansiedad.
          </p>
          <ul class="flex flex-col gap-2 font-body-sm text-body-sm text-on-surface-variant/90 pt-2">
            <li class="flex items-center gap-2">
              <span class="material-symbols-outlined text-secondary text-[18px]">check_circle</span> Simulacros con exámenes de años previos
            </li>
            <li class="flex items-center gap-2">
              <span class="material-symbols-outlined text-secondary text-[18px]">check_circle</span> Gestión del tiempo y calma
            </li>
            <li class="flex items-center gap-2">
              <span class="material-symbols-outlined text-secondary text-[18px]">check_circle</span> Enfoque en maximizar nota de corte
            </li>
          </ul>
        </div>
        <div class="pt-space-xl">
          <a
            class="inline-flex items-center justify-between w-full px-space-lg py-3 rounded-full bg-surface-container-low text-on-surface font-label-md text-label-md hover:bg-secondary hover:text-on-secondary transition-all"
            href="https://wa.me/?text=Hola%20Clara,%20quisiera%20información%20sobre%20Preparación%20de%20Exámenes"
            rel="noopener noreferrer"
            target="_blank"
          >
            <span>Más detalles &amp; temario</span>
            <span class="material-symbols-outlined text-[18px]">arrow_forward</span>
          </a>
        </div>
      </div>

      <!-- Tarjeta 3 -->
      <div class="flex flex-col justify-between p-space-xl rounded-[2.5rem] bg-surface-container-lowest shadow-[0_4px_24px_rgba(36,33,30,0.05)] hover:-translate-y-1.5 transition-all duration-300 group">
        <div class="flex flex-col gap-space-md">
          <div class="w-14 h-14 rounded-full bg-tertiary-fixed/60 flex items-center justify-center text-tertiary group-hover:bg-tertiary group-hover:text-on-tertiary transition-colors">
            <span class="material-symbols-outlined text-[28px]">translate</span>
          </div>
          <div>
            <span class="font-label-sm text-label-sm text-tertiary font-semibold">Cambridge, Oxford &amp; Escuela</span>
            <h3 class="font-headline-md text-[22px] text-on-surface tracking-tight mt-1">Inglés &amp; Idiomas Prácticos</h3>
          </div>
          <p class="font-body-md text-body-md text-on-surface-variant">
            Conversación fluida, gramática intuitiva y preparación de certificaciones oficiales B1/B2/C1 sin memorización fría ni estrés.
          </p>
          <ul class="flex flex-col gap-2 font-body-sm text-body-sm text-on-surface-variant/90 pt-2">
            <li class="flex items-center gap-2">
              <span class="material-symbols-outlined text-secondary text-[18px]">check_circle</span> Speaking activo en cada sesión
            </li>
            <li class="flex items-center gap-2">
              <span class="material-symbols-outlined text-secondary text-[18px]">check_circle</span> Material multimedia interactivo
            </li>
            <li class="flex items-center gap-2">
              <span class="material-symbols-outlined text-secondary text-[18px]">check_circle</span> 100% adaptado a tu ritmo
            </li>
          </ul>
        </div>
        <div class="pt-space-xl">
          <a
            class="inline-flex items-center justify-between w-full px-space-lg py-3 rounded-full bg-surface-container-low text-on-surface font-label-md text-label-md hover:bg-tertiary hover:text-on-tertiary transition-all"
            href="https://wa.me/?text=Hola%20Clara,%20quisiera%20información%20sobre%20Clases%20de%20Inglés"
            rel="noopener noreferrer"
            target="_blank"
          >
            <span>Más detalles &amp; temario</span>
            <span class="material-symbols-outlined text-[18px]">arrow_forward</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

