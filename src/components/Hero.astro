---
import { supabase } from '../db/supabase.js';

let avgRating = '—';
let totalReviews = 0;

try {
  const { data, error } = await supabase
    .from('testimonies')
    .select('stars')
    .eq('approved', true);

  if (!error && data && data.length > 0) {
    const validStars = data.filter((r) => r.stars !== null).map((r) => r.stars as number);
    if (validStars.length > 0) {
      const avg = validStars.reduce((a, b) => a + b, 0) / validStars.length;
      avgRating = avg.toFixed(1);
      totalReviews = validStars.length;
    }
  }
} catch (_) {
  // Fallback silencioso
}
---

