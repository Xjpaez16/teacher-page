<footer class="w-full bg-surface-container-low mt-space-4xl pt-space-3xl pb-space-2xl" id="contacto">
  <div class="max-w-max-width-content mx-auto px-gutter-mobile lg:px-gutter-desktop">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-space-xl pb-space-2xl">
      <!-- Info y Marca -->
      <div class="md:col-span-5 flex flex-col gap-space-md">
        <div class="flex items-center gap-space-sm">
          <img
            alt="Logo Profesora Clara"
            class="h-8 w-auto object-contain"
            src="https://lh3.googleusercontent.com/aida-public/AB6AXuA-EUDuP_duy4XZe-eSJg9Ea9TaOJT9RHrsj-vaFKklxWcYPC9sqke3MwKRwL3qFXWQwLpQAdK_2U6mVXPrIxxAf1qDAKLbnBicR2pg9w8Vd1tRKf9OyqYbq2y9Jm4umFM05lRPB_AWVos9h91_swlkA7pYf-loRvjx6ihwyKprERVDVl59OMtYVoWH0kvxFmwvJU8IoMOVVvUyXOjVbt2aI02OlEK4SF85v_jpd3R5pykbe3ixDD0XIQ"
          />
