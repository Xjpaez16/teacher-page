          </a>
        </div>
      </div>

      <!-- Enlaces rápidos -->
      <div class="md:col-span-3 md:col-start-7 flex flex-col gap-space-sm">
        <span class="font-headline-sm text-headline-sm text-on-surface mb-space-2xs">Enlaces rápidos</span>
        <nav class="flex flex-col gap-space-xs">
          <a class="font-body-md text-body-md text-on-surface-variant hover:text-on-surface transition-colors" href="#sobre-mi">
            Sobre mí
          </a>
          <a class="font-body-md text-body-md text-on-surface-variant hover:text-on-surface transition-colors" href="#servicios">
            Servicios de tutoría
          </a>
          <a class="font-body-md text-body-md text-on-surface-variant hover:text-on-surface transition-colors" href="#testimonios">
            Opiniones y familias
          </a>
          <a class="font-body-md text-body-md text-on-surface-variant hover:text-on-surface transition-colors" href="#galeria">
            Espacio pedagógico
          </a>
          <a class="font-body-md text-body-md text-on-surface-variant hover:text-on-surface transition-colors" href="#contacto">
