---
---

<header class="fixed top-0 inset-x-0 z-50 transition-all duration-300">
  <div class="max-w-max-width-content mx-auto px-gutter-mobile lg:px-gutter-desktop pt-space-sm">
    <div class="h-20 bg-surface-bright/85 backdrop-blur-xl rounded-full px-space-md lg:px-space-lg shadow-[0_4px_24px_-2px_rgba(36,33,30,0.06)] flex items-center justify-between gap-space-sm">
      <div class="flex items-center gap-space-sm shrink-0">
        <img
          alt="Logo Profesora Claudia Sierra"
          class="h-8 w-auto object-contain"
          src="https://lh3.googleusercontent.com/aida-public/AB6AXuA-EUDuP_duy4XZe-eSJg9Ea9TaOJT9RHrsj-vaFKklxWcYPC9sqke3MwKRwL3qFXWQwLpQAdK_2U6mVXPrIxxAf1qDAKLbnBicR2pg9w8Vd1tRKf9OyqYbq2y9Jm4umFM05lRPB_AWVos9h91_swlkA7pYf-loRvjx6ihwyKprERVDVl59OMtYVoWH0kvxFmwvJU8IoMOVVvUyXOjVbt2aI02OlEK4SF85v_jpd3R5pykbe3ixDD0XIQ"
        />
        <a class="flex flex-col text-left group" data-path="sobre-mi" href="#sobre-mi">
          <span class="font-headline-sm text-headline-sm text-on-surface leading-none tracking-tight">Claudia Patricia Sierra</span>
          <span class="font-label-sm text-label-sm text-on-surface-variant">Clases Particulares</span>
        </a>
      </div>

      <nav class="hidden md:flex items-center gap-space-xs p-space-2xs bg-surface-container-low/70 rounded-full" id="desktop-nav">
        <a class="nav-link px-space-md py-space-xs rounded-full font-label-md text-label-md text-on-surface-variant hover:text-on-surface hover:bg-surface-container-high transition-all duration-300 ease-out" href="#sobre-mi">Sobre mí</a>
        <a class="nav-link px-space-md py-space-xs rounded-full font-label-md text-label-md text-on-surface-variant hover:text-on-surface hover:bg-surface-container-high transition-all duration-300 ease-out" href="#servicios">Servicios</a>
        <a class="nav-link px-space-md py-space-xs rounded-full font-label-md text-label-md text-on-surface-variant hover:text-on-surface hover:bg-surface-container-high transition-all duration-300 ease-out" href="#testimonios">Testimonios</a>
        <a class="nav-link px-space-md py-space-xs rounded-full font-label-md text-label-md text-on-surface-variant hover:text-on-surface hover:bg-surface-container-high transition-all duration-300 ease-out" href="#contacto">Contacto</a>
      </nav>

      <div class="flex items-center gap-space-sm shrink-0">
        <a
          class="hidden sm:inline-flex items-center justify-center px-space-lg py-space-xs rounded-full bg-primary text-on-primary font-label-md text-label-md shadow-[0_8px_20px_-4px_rgba(224,109,83,0.35)] hover:bg-primary-container active:scale-[0.98] transition-all duration-300 ease-out"
          data-path="agendar-clase"
          href="https://wa.link/lgzrrc"
          target="_blank"
          rel="noopener noreferrer"
        >
          Agendar clase
        </a>

        <!-- Botón menú hamburguesa (3 líneas) visible en móviles -->
        <button
          id="mobile-menu-btn"
          type="button"
          class="md:hidden w-11 h-11 rounded-full bg-surface-container-low hover:bg-surface-container-high flex items-center justify-center text-on-surface transition-colors cursor-pointer"
          aria-label="Abrir menú de navegación"
          aria-expanded="false"
          aria-controls="mobile-nav-menu"
        >
          <span id="mobile-menu-icon" class="material-symbols-outlined text-[24px]">menu</span>
        </button>
      </div>
    </div>

    <!-- Menú desplegable para móviles -->
    <div
      id="mobile-nav-menu"
      class="md:hidden mt-2 p-space-md bg-surface-bright/95 backdrop-blur-2xl rounded-[2rem] shadow-[0_12px_36px_rgba(36,33,30,0.12)] border border-outline-variant/30 flex flex-col gap-1 transition-all duration-300 ease-out opacity-0 pointer-events-none -translate-y-2"
    >
      <a
        class="mobile-nav-link nav-link px-space-md py-3 rounded-full font-label-md text-label-md text-on-surface-variant hover:text-on-surface hover:bg-surface-container-high transition-all"
        href="#sobre-mi"
      >
        Sobre mí
      </a>
      <a
        class="mobile-nav-link nav-link px-space-md py-3 rounded-full font-label-md text-label-md text-on-surface-variant hover:text-on-surface hover:bg-surface-container-high transition-all"
        href="#servicios"
      >
        Servicios
      </a>
      <a
        class="mobile-nav-link nav-link px-space-md py-3 rounded-full font-label-md text-label-md text-on-surface-variant hover:text-on-surface hover:bg-surface-container-high transition-all"
        href="#testimonios"
      >
        Testimonios
      </a>
      <a
        class="mobile-nav-link nav-link px-space-md py-3 rounded-full font-label-md text-label-md text-on-surface-variant hover:text-on-surface hover:bg-surface-container-high transition-all"
        href="#contacto"
      >
        Contacto
      </a>
      <div class="pt-2 border-t border-surface-container-high/60 sm:hidden">
        <a
          class="inline-flex items-center justify-center w-full py-3 rounded-full bg-primary text-on-primary font-label-md text-label-md shadow-sm hover:bg-primary-container active:scale-[0.98] transition-all"
          href="https://wa.link/lgzrrc"
          target="_blank"
          rel="noopener noreferrer"
        >
          Agendar clase
        </a>
      </div>
    </div>
  </div>
</header>

<script>
  // Control del menú hamburguesa móvil
  const mobileMenuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenuIcon = document.getElementById('mobile-menu-icon');
  const mobileNavMenu = document.getElementById('mobile-nav-menu');
  let isMenuOpen = false;

  function toggleMobileMenu(open?: boolean) {
    isMenuOpen = open !== undefined ? open : !isMenuOpen;
    if (!mobileNavMenu || !mobileMenuBtn || !mobileMenuIcon) return;

    mobileMenuBtn.setAttribute('aria-expanded', String(isMenuOpen));

    if (isMenuOpen) {
      mobileNavMenu.classList.remove('opacity-0', 'pointer-events-none', '-translate-y-2');
      mobileNavMenu.classList.add('opacity-100', 'pointer-events-auto', 'translate-y-0');
      mobileMenuIcon.textContent = 'close';
    } else {
      mobileNavMenu.classList.add('opacity-0', 'pointer-events-none', '-translate-y-2');
      mobileNavMenu.classList.remove('opacity-100', 'pointer-events-auto', 'translate-y-0');
      mobileMenuIcon.textContent = 'menu';
    }
  }

  mobileMenuBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    toggleMobileMenu();
  });

  // Cerrar al hacer clic fuera del menú móvil
  document.addEventListener('click', (e) => {
    if (isMenuOpen && mobileNavMenu && !mobileNavMenu.contains(e.target as Node) && e.target !== mobileMenuBtn) {
      toggleMobileMenu(false);
    }
  });

  // Manejo de scroll suave y preciso para evitar saltos bruscos
  const navLinks = document.querySelectorAll<HTMLAnchorElement>('.nav-link, a[href="#sobre-mi"], a[href="#testimonios"], a[href="#servicios"], a[href="#contacto"]');

  navLinks.forEach((link) => {
    link.addEventListener('click', (e) => {
      const href = link.getAttribute('href');
      if (!href || !href.startsWith('#')) return;
      const target = document.querySelector(href);
      if (target) {
        e.preventDefault();
        // Si el menú móvil está abierto, cerrarlo al seleccionar una sección
        if (isMenuOpen) {
          toggleMobileMenu(false);
        }

        const headerOffset = 90;
        const targetPosition = target.getBoundingClientRect().top + window.scrollY - headerOffset;

        window.scrollTo({
          top: targetPosition,
          behavior: 'smooth'
        });

        // Actualizar la URL de forma limpia sin salto brusco
        window.history.pushState(null, '', href);
      }
    });
  });

  // Indicador de enlace activo según la sección visible
  const sections = ['sobre-mi', 'servicios', 'testimonios', 'contacto'];
  const desktopLinks = document.querySelectorAll<HTMLAnchorElement>('#desktop-nav .nav-link');
  const mobileLinks = document.querySelectorAll<HTMLAnchorElement>('#mobile-nav-menu .mobile-nav-link');

  function updateActiveLink() {
    const scrollPos = window.scrollY + 140;
    let currentId = '';

    for (const id of sections) {
      const el = document.getElementById(id);
      if (el) {
        const top = el.offsetTop;
        const height = el.offsetHeight;
        if (scrollPos >= top && scrollPos < top + height) {
          currentId = id;
          break;
        }
      }
    }

    desktopLinks.forEach((link) => {
      const href = link.getAttribute('href');
      if (href === `#${currentId}`) {
        link.classList.add('bg-primary-fixed', 'text-on-primary-fixed', 'font-medium', 'shadow-sm');
        link.classList.remove('text-on-surface-variant');
      } else {
        link.classList.remove('bg-primary-fixed', 'text-on-primary-fixed', 'font-medium', 'shadow-sm');
        link.classList.add('text-on-surface-variant');
      }
    });

    mobileLinks.forEach((link) => {
      const href = link.getAttribute('href');
      if (href === `#${currentId}`) {
        link.classList.add('bg-primary-fixed', 'text-on-primary-fixed', 'font-semibold');
        link.classList.remove('text-on-surface-variant');
      } else {
        link.classList.remove('bg-primary-fixed', 'text-on-primary-fixed', 'font-semibold');
        link.classList.add('text-on-surface-variant');
      }
    });
  }

  window.addEventListener('scroll', updateActiveLink, { passive: true });
  updateActiveLink();
</script>

