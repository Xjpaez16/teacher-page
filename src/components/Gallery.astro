<section class="w-full py-space-3xl lg:py-space-4xl" id="galeria">
  <div class="max-w-max-width-content mx-auto px-gutter-mobile lg:px-gutter-desktop">
    <div class="flex flex-col items-center text-center max-w-2xl mx-auto gap-space-xs mb-space-2xl">
      <span class="inline-flex items-center px-space-md py-1 rounded-full bg-secondary-fixed text-on-secondary-fixed font-label-sm text-label-sm">
        Espacio de trabajo
      </span>
      <h2 class="font-headline-lg text-headline-lg-mobile lg:text-headline-lg text-on-surface tracking-tight">
        Un vistazo a nuestras clases y espacio de trabajo
      </h2>
      <p class="font-body-md text-body-md text-on-surface-variant">
        Ambientes luminosos, materiales interactivos y sesiones llenas de motivación.
      </p>
    </div>

    <!-- 4 Cards Visual Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-space-md">
      {galleryItems.map((item) => (
        <div class="group relative overflow-hidden rounded-[2.5rem] bg-surface-container-lowest shadow-[0_4px_20px_rgba(36,33,30,0.06)] aspect-square flex flex-col">
          <img
            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 ease-out"
            alt={item.alt}
            src={item.src}
            loading="lazy"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-on-surface/80 via-transparent to-transparent opacity-80 group-hover:opacity-90 transition-opacity"></div>
          <div class="absolute bottom-0 inset-x-0 p-space-lg text-white">
            <span class={`font-label-sm text-label-sm ${item.badgeColor}`}>{item.badge}</span>
            <p class="font-headline-sm text-[16px] text-white font-semibold mt-0.5">{item.title}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

